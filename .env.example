# Every variable agora reads. The deploy provides exactly these and nothing else — rule 9 of
# docs/ecosystem/03 §2. A container that receives a variable it does not use is a secret with a
# larger blast radius than it needs.
#
# Values are empty on purpose: a secret whose whole job is to live outside the repository does
# not belong in a file people copy. Where a default exists it is written in the comment, not in
# the value, so that copying this file produces a deployment that has decided nothing by accident.
#
# `src/env.ts` is the authority. This file is derived from it by hand and the two drift the moment
# somebody adds a variable there and not here — which is why the deploy manifest is written from
# THIS file: a variable nobody wrote down is a variable nobody sets.

# ── required: the service will not start without these ───────────────────────────────────────────

# Rule 1. One database, named by this service's own variable, and the CI check greps `src/` for any
# other connection-string token.
AGORA_DATABASE_URL=

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL, and both empty here on purpose: a development stack is one
# network. See micro-deploy `docs/network-consolidation.md`.
#
# Set the second DSN and this deployment holds a handle per network, choosing
# per request from the `CF-Network` header the gateway stamps. Leave it empty and
# `networkSql` holds one handle and REFUSES a testnet request rather than
# answering it out of mainnet rows.
AGORA_DATABASE_URL_TESTNET=
# ── WHICH ESTATE THIS DEPLOYMENT IS ───────────────────────────────────────────
#
# REQUIRED in the estate, and the render sets it for every pod. It was once
# documented here as "never in production" and that was wrong twice over:
#
#   1. The pod keys its own database handle by it. Without it a testnet
#      deployment registers its testnet DSN under the name `mainnet` and then
#      refuses every request stamped `CF-Network: testnet`.
#
#   2. SERVICE-TO-SERVICE CALLS NEVER REACH THE GATEWAY. An outbox relay POSTing
#      to another service goes container to container; nothing stamps a header
#      on it and nothing can. Without a declared network those answer 500.
#
# The header still WINS when present, so this cannot mask a mis-stamped request
# from outside — it only answers the internal callers that never had one. Leave
# it empty only where a pod genuinely serves both estates.
CF_NETWORK_SINGLE=


# Where a presented bearer is verified, and who must have issued it. Both required: a service that
# defaulted its issuer would accept a token minted by any identity that could reach it.
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=

# The estate's shared event-bus HMAC key. On this service it signs the outbox AND verifies inbound
# events — and consuming `identity.user.deleted` means erasing a person's voice, their posts and
# their whispers, so an unset one here would be a free account-deletion endpoint. Asserted to be
# genuinely generated (32 decoded bytes, alphabet, entropy floor), not merely long.
OUTBOX_SIGNING_SECRET=

# ── optional: absent is a supported state, and each one has a stated meaning ──────────────────────

# Default 4150.
PORT=

# Default 10.
AGORA_DATABASE_POOL_MAX=

# Where a service token is minted. Defaults to IDENTITY_ISSUER.
IDENTITY_URL=

# The long-lived `cfsc_…` credential this service exchanges for a service token. Empty is supported
# — the migrator shares this environment and dials nobody — but a PLACEHOLDER is not: it is a
# deployment that believes it has a credential and finds out otherwise on its first call to policy.
AGORA_IDENTITY_CREDENTIAL=

# The moderation gate. Soft, fail-open-and-flag. Empty means this deployment has no gate wired, and
# every post then records `moderation_degraded` — a thing a report queue can be filtered on, rather
# than a silence that reads as approval.
POLICY_URL=

# Default 5000. Range 100–60000.
AGORA_UPSTREAM_DEADLINE_MS=

# Where a BROWSER reaches micro-studio — not where this service reaches it (this service never calls
# studio at all). It composes the `bytesUrl` a read hands to a client. Empty means every `bytesUrl`
# is null, which a client can render a sentence about; a guessed hostname is a broken image with no
# diagnosis. `STUDIO_URL` would be a container name on a private network and wrong in every browser.
STUDIO_PUBLIC_URL=

# Where a BROWSER reaches agora-web. One consumer: the `url` on `agora.notification.mail_requested`,
# so the mail micro-notify sends has somewhere to go. notify renders links against NOTIFY_PUBLIC_URL,
# which is the hub, and the hub has no route into the square. Empty is supported — the payload then
# carries no `url` and notify falls back to the hub's notification centre, a real page one hop away.
AGORA_PUBLIC_URL=

# ── the rate limits, which are the product rather than a tuning knob ─────────────────────────────
#
# A public square with no floor rate is a spam channel within a day of being indexed. These are
# validated at boot, so a deployment that sets one to zero finds out then instead of at the first
# post. `ratelimit.ts` enforces them in the same transaction as the write, which is the only way a
# limit survives two replicas.

# Default 60 — one a minute sustained, which no human does and every script does.
AGORA_POSTS_PER_HOUR=

# Default 30. Tighter than posts on purpose: an unsolicited message is the one thing here that
# arrives whether or not the recipient asked for it.
AGORA_WHISPERS_PER_HOUR=

# Default 100. A follow storm is how a scraper maps a graph.
AGORA_FOLLOWS_PER_HOUR=

# ── shape ────────────────────────────────────────────────────────────────────────────────────────

# Default and ceiling are `MAX_POST_CHARS` in src/text.ts, which is also what migration 2's CHECK on
# `posts.body` is written at. This narrows per deployment; it can never widen past the column.
AGORA_POST_MAX_CHARS=

# Default 50. There is no infinite scroll — big enough that "load more" is not a chore, small enough
# that a scraper pays for the graph a page at a time.
AGORA_PAGE_SIZE_MAX=

# Default true. Posting can be paused without pausing the service; nothing already written is lost.
AGORA_POSTING_ENABLED=

# Default 90. Read notifications go early, unread ones at the full term: an unread notification is
# the only record that something happened.
AGORA_NOTIFICATION_TTL_DAYS=

# ── platform ─────────────────────────────────────────────────────────────────────────────────────

# Defaults: development, dev, info, the container hostname.
NODE_ENV=
CLOUDSFORGE_TAG=
LOG_LEVEL=
INSTANCE_ID=

# Read by @cloudsforge/telemetry, not by src/env.ts. Unset means traces are not exported.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ═════════════════════════════════════════════════════════════════════════════════════════════════
# WAVE M5a — THE FOUR MODULES THIS PROCESS ABSORBED
#
# micro-deploy `docs/service-merge-plan.md`. devplatform, policy, pricing and studio now run as
# modules inside this image. Their DATABASES ARE KEPT under their existing names — there is no
# schema merge, and `src/migratortargets.ts` refuses to issue a statement if any two of the five
# ever address one database, because `inbox` and `jobs` exist in all five schemas and a shared
# ledger would leave the later modules' tables uncreated with a green migrator.
#
# Every variable below was already read by the service it belongs to, under the same name, so the
# deploy gains variables rather than changing any. `src/devplatform/env.test.ts` checks BOTH
# directions against this file: a variable a module reads and this file does not declare is a
# variable nobody sets, and a variable this file declares that no module's `env.ts` reads is a
# secret in the deploy manifest for nothing.
# ═════════════════════════════════════════════════════════════════════════════════════════════════

# ── devplatform ──────────────────────────────────────────────────────────────────────────────────

# Rule 1 still holds per MODULE: one database each, named by that module's own variable.
DEVPLATFORM_DATABASE_URL=
DEVPLATFORM_DATABASE_URL_TESTNET=
# Default 10.
DEVPLATFORM_DATABASE_POOL_MAX=

# ── THE ONE SECRET THIS MERGE COULD NOT SHARE ──────────────────────────────────────────────────
#
# REQUIRED, and a LIST so a rotation has an overlap. It is NOT `OUTBOX_SIGNING_SECRET`, which this
# module also reads for the opposite direction — signing what its relay delivers to customers.
#
# It is the whole reason `POST /v1/events` had to split three ways in the merged process: agora,
# policy and devplatform each verify an inbound delivery with a DIFFERENT key, so one shared route
# would be one key silently deciding for three. Each module serves `/v1/events/<module>` and the
# bare path answers 410. See `MOUNTED_EVENTS_PATH` in `src/server.ts`.
DEVPLATFORM_INGEST_SECRETS=CHANGE_ME

# Defaults: 600 per minute, 1000000 per month.
DEVPLATFORM_DEFAULT_QUOTA_PER_MINUTE=
DEVPLATFORM_DEFAULT_QUOTA_PER_MONTH=

# Defaults: 1440 minutes of overlap on a rotated webhook secret, a 5000 ms delivery deadline, and
# 8 attempts before a delivery is abandoned.
DEVPLATFORM_WEBHOOK_ROTATION_OVERLAP_MINUTES=
DEVPLATFORM_WEBHOOK_DEADLINE_MS=
DEVPLATFORM_WEBHOOK_MAX_ATTEMPTS=

# Defaults: 35 days of raw usage events, 400 days of rollups. The rollup term must be at least the
# event term, and `env.ts` refuses a configuration where it is not.
DEVPLATFORM_USAGE_EVENT_RETENTION_DAYS=
DEVPLATFORM_USAGE_ROLLUP_RETENTION_DAYS=

# ── policy ───────────────────────────────────────────────────────────────────────────────────────

POLICY_DATABASE_URL=
POLICY_DATABASE_URL_TESTNET=
# Default 10.
POLICY_DATABASE_POOL_MAX=

# Defaults: 730 days of decisions, 48 hours of velocity counters.
POLICY_DECISION_RETENTION_DAYS=
POLICY_COUNTER_RETENTION_HOURS=

# OPTIONAL, and preferred over OUTBOX_SIGNING_SECRET when set. Empty is a SUPPORTED state and means
# "cannot verify yet": `POST /v1/events/policy` then answers 503 rather than accepting anything,
# because the alternative would let an unauthenticated caller erase any user.
OUTBOX_ACCEPT_SECRETS=

# ── pricing ──────────────────────────────────────────────────────────────────────────────────────

PRICING_DATABASE_URL=
PRICING_DATABASE_URL_TESTNET=
# Default 10.
PRICING_DATABASE_POOL_MAX=

# Default 2. How many of the four venues must agree before a round counts. The estate has shipped
# with 1, which makes the divergence check inert; that is a deployment fact, not a default.
PRICING_MIN_SOURCES=
# Default 200 basis points. Two venues further apart than this do not make a quote.
PRICING_MAX_DIVERGENCE_BPS=
# Default 300 seconds. Past this a stored quote is unusable and every conversion stops.
PRICING_MAX_AGE_SECONDS=
# Default 4000 ms — the ONLY deadline on an outbound feed call, applied by AbortSignal.timeout in
# `src/pricing/sources.ts`. There is no per-source retry and no backoff: a venue that is down costs
# one vote out of four and PRICING_MIN_SOURCES decides whether that matters.
PRICING_SOURCE_TIMEOUT_MS=
# Default 60 seconds. The `price.refresh` job's re-arm interval — a leased job, not a timer.
PRICING_REFRESH_SECONDS=
# Default 100 basis points.
PRICING_CONVERSION_SPREAD_BPS=

# ── studio ───────────────────────────────────────────────────────────────────────────────────────

STUDIO_DATABASE_URL=
STUDIO_DATABASE_URL_TESTNET=
# Default 10.
STUDIO_DATABASE_POOL_MAX=

# ── THE PVC, AND THE ONE VARIABLE THAT MUST NOT BE LEFT UNSET ──────────────────────────────────
#
# Defaults to `./out`, and that default is how the estate once ran with a root-owned `/app/out`
# under a non-root user: every generation failed EACCES while the container reported healthy and
# `/readyz` answered 200. The merged process asserts the root is WRITABLE at boot and refuses to
# start otherwise, and `asset-root` is a HARD readiness probe — so an unwritable root now takes the
# whole merged pod out of the balancer, which is deliberate.
#
# The deployment mounts the `studio-assets` PersistentVolumeClaim here. A writable default in the
# image would send generated assets into a container layer, to be lost on the next redeploy.
STUDIO_ASSET_ROOT=
# Empty means `storage_url` is written as a `file://` URL of the absolute path.
STUDIO_ASSET_BASE_URL=

# The image model. Endpoint and key must both be set or neither; with neither, only placeholder
# generation is available and the `image-backend` probe reports `degraded` rather than failing.
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=CHANGE_ME
# Defaults: /providers/blackforestlabs/v1/flux-2-pro and 2025-04-01-preview.
AZURE_FOUNDRY_IMAGE_PATH=
AZURE_FOUNDRY_API_VERSION=
# Required when AZURE_FOUNDRY_ENDPOINT is set; default FLUX.2-pro. The fallback must differ.
STUDIO_IMAGE_MODEL=
STUDIO_IMAGE_FALLBACK_MODEL=

# Defaults: a 120000 ms deadline, 0.06 dollars per image, a 5 dollar per-owner credit cap.
STUDIO_IMAGE_DEADLINE_MS=
STUDIO_IMAGE_PRICE_USD=
STUDIO_DEFAULT_CREDIT_CAP_USD=

# ══════════════════════════════════════════════════════════════════════════════
# WAVE M5b — THE COMMERCE/GAMES TIER (community, market, billing, mint, foresight,
# worlds, tessera). Each is a MODULE of this process now; each reads its OWN database
# URL and configuration below. Secret slots (_SECRET/_SECRETS) are left EMPTY on
# purpose — a secret whose job is to live outside the repository does not belong in a
# file people copy; the estate bootstrap mints them. Credentials/tokens likewise.
# ══════════════════════════════════════════════════════════════════════════════

# ── Shared upstreams these modules dial (a URL is never a secret) ──
ADMIN_API_URL=http://admin-api:4000
CUSTODY_URL=http://127.0.0.1:4005
INDEXER_BASE_URL=
INDEXER_DEADLINE_MS=5000
INDEXER_NETWORK=mainnet
INDEXER_URL=http://127.0.0.1:4004
LEDGER_BASE_URL=http://ledger:4000
LEDGER_DEADLINE_MS=5000
LEDGER_URL=http://127.0.0.1:4007
POLICY_BASE_URL=http://policy:4000
POLICY_DEADLINE_MS=3000
PRICING_URL=http://127.0.0.1:4009
STUDIO_URL=http://127.0.0.1:4111

# ── community ──
COMMUNITY_DATABASE_POOL_MAX=10
COMMUNITY_DATABASE_URL=postgres://community:CHANGE_ME_DB_PASSWORD@postgres:5432/community
COMMUNITY_DATABASE_URL_TESTNET=
COMMUNITY_GATE_RECHECK_BATCH_SIZE=100
COMMUNITY_GATE_RECHECK_INTERVAL_HOURS=6
COMMUNITY_IDEMPOTENCY_TTL_DAYS=30
COMMUNITY_IDENTITY_CREDENTIAL=CHANGE_ME_a_cfsc_credential_from_estate_bootstrap
COMMUNITY_INGEST_SECRETS=
COMMUNITY_SERVICE_CREDENTIAL=
COMMUNITY_URL=http://127.0.0.1:4109

# ── market ──
MARKET_AUCTION_EXTENSION_MS=120000
MARKET_DATABASE_POOL_MAX=10
MARKET_DATABASE_URL=postgres://market:market@127.0.0.1:5432/market
MARKET_DATABASE_URL_TESTNET=
MARKET_DISPUTE_WINDOW_MS=86400000
MARKET_IDENTITY_CREDENTIAL=
MARKET_LISTING_ENABLED=true
MARKET_MAX_ROYALTY_BPS=1000
MARKET_PLATFORM_FEE_BPS=250
MARKET_SERVICE_TOKEN=
