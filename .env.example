# Every variable agora reads. The deploy provides exactly these and nothing else — rule 9 of
# docs/ecosystem/03 §2. A container that receives a variable it does not use is a secret with a
# larger blast radius than it needs.
#
# Values are empty on purpose: a secret whose whole job is to live outside the repository does
# not belong in a file people copy. Where a default exists it is written in the comment, not in
# the value, so that copying this file produces a deployment that has decided nothing by accident.
#
# `src/env.ts` is the authority. This file is derived from it by hand and the two drift the moment
# somebody adds a variable there and not here — which is why the deploy manifest is written from
# THIS file: a variable nobody wrote down is a variable nobody sets.

# ── required: the service will not start without these ───────────────────────────────────────────

# Rule 1. One database, named by this service's own variable, and the CI check greps `src/` for any
# other connection-string token.
AGORA_DATABASE_URL=

# ── SERVING BOTH NETWORKS FROM ONE POD ────────────────────────────────────────
#
# Both OPTIONAL, and both empty here on purpose: a development stack is one
# network. See micro-deploy `docs/network-consolidation.md`.
#
# Set the second DSN and this deployment holds a handle per network, choosing
# per request from the `CF-Network` header the gateway stamps. Leave it empty and
# `networkSql` holds one handle and REFUSES a testnet request rather than
# answering it out of mainnet rows.
AGORA_DATABASE_URL_TESTNET=
#
# The network to assume when no `CF-Network` arrives. For `pnpm dev`, which has
# no gateway in front of it. NEVER set in production: there an unstamped request
# is a routing fault, and guessing turns it into a silent cross-network write.
CF_NETWORK_SINGLE=


# Where a presented bearer is verified, and who must have issued it. Both required: a service that
# defaulted its issuer would accept a token minted by any identity that could reach it.
IDENTITY_JWKS_URL=
IDENTITY_ISSUER=

# The estate's shared event-bus HMAC key. On this service it signs the outbox AND verifies inbound
# events — and consuming `identity.user.deleted` means erasing a person's voice, their posts and
# their whispers, so an unset one here would be a free account-deletion endpoint. Asserted to be
# genuinely generated (32 decoded bytes, alphabet, entropy floor), not merely long.
OUTBOX_SIGNING_SECRET=

# ── optional: absent is a supported state, and each one has a stated meaning ──────────────────────

# Default 4150.
PORT=

# Default 10.
AGORA_DATABASE_POOL_MAX=

# Where a service token is minted. Defaults to IDENTITY_ISSUER.
IDENTITY_URL=

# The long-lived `cfsc_…` credential this service exchanges for a service token. Empty is supported
# — the migrator shares this environment and dials nobody — but a PLACEHOLDER is not: it is a
# deployment that believes it has a credential and finds out otherwise on its first call to policy.
AGORA_IDENTITY_CREDENTIAL=

# The moderation gate. Soft, fail-open-and-flag. Empty means this deployment has no gate wired, and
# every post then records `moderation_degraded` — a thing a report queue can be filtered on, rather
# than a silence that reads as approval.
POLICY_URL=

# Default 5000. Range 100–60000.
AGORA_UPSTREAM_DEADLINE_MS=

# Where a BROWSER reaches micro-studio — not where this service reaches it (this service never calls
# studio at all). It composes the `bytesUrl` a read hands to a client. Empty means every `bytesUrl`
# is null, which a client can render a sentence about; a guessed hostname is a broken image with no
# diagnosis. `STUDIO_URL` would be a container name on a private network and wrong in every browser.
STUDIO_PUBLIC_URL=

# Where a BROWSER reaches agora-web. One consumer: the `url` on `agora.notification.mail_requested`,
# so the mail micro-notify sends has somewhere to go. notify renders links against NOTIFY_PUBLIC_URL,
# which is the hub, and the hub has no route into the square. Empty is supported — the payload then
# carries no `url` and notify falls back to the hub's notification centre, a real page one hop away.
AGORA_PUBLIC_URL=

# ── the rate limits, which are the product rather than a tuning knob ─────────────────────────────
#
# A public square with no floor rate is a spam channel within a day of being indexed. These are
# validated at boot, so a deployment that sets one to zero finds out then instead of at the first
# post. `ratelimit.ts` enforces them in the same transaction as the write, which is the only way a
# limit survives two replicas.

# Default 60 — one a minute sustained, which no human does and every script does.
AGORA_POSTS_PER_HOUR=

# Default 30. Tighter than posts on purpose: an unsolicited message is the one thing here that
# arrives whether or not the recipient asked for it.
AGORA_WHISPERS_PER_HOUR=

# Default 100. A follow storm is how a scraper maps a graph.
AGORA_FOLLOWS_PER_HOUR=

# ── shape ────────────────────────────────────────────────────────────────────────────────────────

# Default and ceiling are `MAX_POST_CHARS` in src/text.ts, which is also what migration 2's CHECK on
# `posts.body` is written at. This narrows per deployment; it can never widen past the column.
AGORA_POST_MAX_CHARS=

# Default 50. There is no infinite scroll — big enough that "load more" is not a chore, small enough
# that a scraper pays for the graph a page at a time.
AGORA_PAGE_SIZE_MAX=

# Default true. Posting can be paused without pausing the service; nothing already written is lost.
AGORA_POSTING_ENABLED=

# Default 90. Read notifications go early, unread ones at the full term: an unread notification is
# the only record that something happened.
AGORA_NOTIFICATION_TTL_DAYS=

# ── platform ─────────────────────────────────────────────────────────────────────────────────────

# Defaults: development, dev, info, the container hostname.
NODE_ENV=
CLOUDSFORGE_TAG=
LOG_LEVEL=
INSTANCE_ID=

# Read by @cloudsforge/telemetry, not by src/env.ts. Unset means traces are not exported.
OTEL_EXPORTER_OTLP_ENDPOINT=
