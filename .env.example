BILLING_IDENTITY_CREDENTIAL=
BILLING_LEDGER_DEADLINE_MS=5000
BILLING_LEDGER_TOKEN=
BILLING_LEDGER_URL=http://ledger:4000
BILLING_PRICING_DEADLINE_MS=
BILLING_PRICING_URL=
BILLING_URL=http://127.0.0.1:4009

# ── mint ──
MINT_DATABASE_POOL_MAX=10
MINT_DATABASE_URL=postgres://mint:mint@127.0.0.1:5432/mint
MINT_DATABASE_URL_TESTNET=
MINT_DEPLOYS_ENABLED=true
MINT_DEPLOY_PRICE_SHARDS=
MINT_DEPLOY_PRICE_USD_CENTS=2500
