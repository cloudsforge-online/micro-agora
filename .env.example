MARKET_URL=http://127.0.0.1:4113

# ── billing ──
BILLING_ADMIN_API_DEADLINE_MS=5000
BILLING_ADMIN_API_TOKEN=
BILLING_DATABASE_POOL_MAX=10
BILLING_DATABASE_URL=postgres://cloudsforge:CHANGE_ME@postgres:5432/billing
BILLING_DATABASE_URL_TESTNET=
